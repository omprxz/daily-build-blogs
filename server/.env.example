# ==============================================================================
# DailyBuild Blogs — Server Environment Configuration (.env)
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000
APP_NAME="Daily Build Blogs"
APP_URL=https://blogs.dailybuild.tech

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Full connection URI: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/daily_build_blogs
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=daily_build_blogs

# ------------------------------------------------------------------------------
# Cryptographic Keys & Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# JWT Secret for admin session tokens (generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_64_character_hex_string_for_jwt_signing

# Session Secret (generate via: openssl rand -hex 32)
SESSION_SECRET=replace_with_64_character_hex_string_for_session

# Master Encryption Key for AES-256-GCM encryption of stored AI Provider API keys
# MUST be exactly 64 hex characters (32 bytes). Generate via: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Initial Administrator Account (Seeded on first migration/seed)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@dailybuild.tech
ADMIN_NAME="System Administrator"
ADMIN_PASSWORD=ChangeMe_StrongPassword2026!

# ------------------------------------------------------------------------------
# Media & Storage Settings
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# Process Architecture & Worker Control
# ------------------------------------------------------------------------------
# Set to 'true' if running a separate background worker process (e.g. via PM2 dailybuild-worker)
# Set to 'false' to allow the Express server to run the background scheduler embedded
DISABLE_WORKER=false

# ------------------------------------------------------------------------------
# AI Provider Keys & Local Inference (Optional / Fill what you use)
# ------------------------------------------------------------------------------
# Google Gemini (Text, Structured JSON, & Imagen 3 16:9 thumbnails)
GEMINI_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini, o3-mini, DALL-E)
OPENAI_API_KEY=

# OpenRouter (Aggregator for 300+ frontier & open-source models)
OPENROUTER_API_KEY=

# Groq Cloud (Ultra-fast Llama 3 / Mixtral inference)
GROQ_API_KEY=

# Self-Hosted Ollama Base URL
OLLAMA_BASE_URL=http://localhost:11434

# Standalone xAI Grok / Anthropic Claude keys (Alternative to OpenRouter)
XAI_GROK_API_KEY=
ANTHROPIC_API_KEY=

# Local CLI Provider Executable Paths (Leave blank to use system PATH auto-detection)
TGPT_PATH=
AGY_PATH=
CLICHAT_REPO_PATH=

# ------------------------------------------------------------------------------
# Local Desktop Agent Automation (Dual-Mode Webhook & Polling)
# ------------------------------------------------------------------------------
# Secret token shared with local-agent/ running on editor's machine
LOCAL_AGENT_SECRET=generate_strong_random_token_for_local_agent

# ------------------------------------------------------------------------------
# Workflow Automation Engine & Cron Schedules
# ------------------------------------------------------------------------------
EMERGENCY_KILL_SWITCH_ACTIVE=false
WORKFLOW_EXECUTION_TIMEOUT_MS=120000
CRON_SCHEDULE_FEED_POLLING="*/30 * * * *"
CRON_SCHEDULE_AUTO_PUBLISH="0 * * * *"

# ------------------------------------------------------------------------------
# Google Cloud Platform & SEO Telemetry (Optional)
# ------------------------------------------------------------------------------
# Google PageSpeed Insights API Key (or reuse GEMINI_API_KEY)
GOOGLE_PAGESPEED_API_KEY=

# Google Search Console & GA4 OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://blogs.dailybuild.tech/api/sites/gsc/oauth-callback
