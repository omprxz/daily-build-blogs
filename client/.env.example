# ==============================================================================
# DailyBuild Blogs — Client Environment Configuration (.env)
# ==============================================================================

# Client SSR Express Server Port (when running client server.js independently)
PORT=4444

# Public Web Application Base URL (Canonical URL for SSR metadata & OpenGraph)
APP_URL=https://blogs.dailybuild.tech

# Internal Backend Target for SSR Proxying (Express API endpoint)
API_TARGET=http://localhost:4000

# Client Browser API Base URL (consumed by Vite during build/client execution)
VITE_API_BASE_URL=http://localhost:4000/api
