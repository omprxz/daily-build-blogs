# Daily Build Blogs - Local Automation Agent Configuration

# Port for local agent HTTP webhook listener (expose via: ngrok http 4500)
PORT=4500

# Daily Build Server API Base URL
SERVER_URL=http://localhost:4000

# Shared Secret Token (Must match the Secret in Daily Build Admin -> Local Agent Settings)
AGENT_SECRET=your_secure_agent_secret_here

# Worker Identifier (identifies this machine in Admin Dashboard)
WORKER_NAME=Local-Worker-01

# ChatGPT Browser Profile Directory (stores cookies so you stay logged into ChatGPT)
PROFILE_DIR=./chatgpt-profile

# Headless mode: false opens visible browser tab on your laptop, true runs silently
HEADLESS=false

# Polling Interval (in milliseconds) as backup to Webhook
POLL_INTERVAL_MS=5000
